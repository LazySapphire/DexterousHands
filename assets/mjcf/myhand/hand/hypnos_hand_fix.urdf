    <child link="tmb_MF"/>
    <origin rpy="0 0 0" xyz="0.031554 -0.012560 0.006266"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.57" upper="0.42" velocity="3.14"/>
  </joint>

  <!-- Thumb DF (Distal Finger) -->
  <link name="tmb_DF">
