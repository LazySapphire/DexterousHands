  </link>

  <joint name="jot_tmb_AXIS" type="revolute">
    <parent link="tmb_ROOT"/>
    <child link="tmb_AXIS"/>
    <origin rpy="0 0 0" xyz="0.011495 0 -0.010416"/>
    <axis xyz="-1 0 -0.0875"/>
    <limit effort="10" lower="-0.202" upper="1.02" velocity="3.14"/>
  </joint>

  <!-- Thumb MF (Middle Finger) -->
  <link name="tmb_MF">
