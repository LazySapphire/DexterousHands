      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="thumb_material"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../stls/tmb_AXIS.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
