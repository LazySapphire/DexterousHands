<?xml version="1.0" encoding="utf-8"?>
<robot name="hypnos_hand">
  <!-- Base link - palm -->
  <link name="base_link">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../stls/palm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="palm_material">
        <color rgba="0.93 0.93 0.93 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../stls/palm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Palm fix - fixed part of the palm -->
  <link name="palm_fix">
    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../stls/palm_fix.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="palm_fix_material">
        <color rgba="0.93 0.93 0.93 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../stls/palm_fix.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <joint name="palm_fix_joint" type="fixed">
    <parent link="base_link"/>
    <child link="palm_fix"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- THUMB FINGER -->
  <!-- Thumb ROOT -->
  <link name="tmb_ROOT">
    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../stls/tmb_ROOT.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="thumb_material">
        <color rgba="0.93 0.93 0.93 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="../stls/tmb_ROOT.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <joint name="jot_tmb_ROOT" type="revolute">
    <parent link="base_link"/>
    <child link="tmb_ROOT"/>
    <origin rpy="0 0 0" xyz="0.033278 0.011 0.009418"/>
    <axis xyz="-0.0875 0 1"/>
    <limit effort="10" lower="-2.02" upper="0.202" velocity="3.14"/>
  </joint>

  <!-- Thumb AXIS -->
  <link name="tmb_AXIS">
    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
